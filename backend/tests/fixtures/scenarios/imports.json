{
  "format": "plamotrack-scenarios",
  "version": 1,
  "note": "Archive imports (§12.4, §12.5, AGENTS.md rule 10): re-importing your own export changes nothing in any mode, and an import never derives stock. `\"archive\": \"export\"` is this instance's own export at that step; `{\"tables\": ...}` is a hand-written sheet in CSV cells. Read by backend/tests/test_scenarios.py AND by plamotrack-ios's domain tests. Add a case here rather than to either suite. The format is .agents/testing-and-review.md → 'Behaviour scenarios'. `why` is for the reader; nothing asserts on it.",
  "scenarios": [
    {
      "id": "merging-your-own-export-changes-nothing",
      "why": "§12.5: every row matches by id and differs in nothing, so nothing is created, updated or skipped",
      "given": {
        "retailers": [{ "id": "@retailers:hlj", "name": "Hobby Link Japan", "rating": 5 }],
        "consumables": [
          { "id": "@consumables:marker", "name": "Gundam Marker GM01", "category": "marker", "quantity_on_hand": 3 }
        ],
        "orders": [
          { "id": "@orders:hlj", "retailer_id": "@retailers:hlj", "order_date": "2026-03-14", "currency_code": "JPY", "received_at": "2026-03-20T00:00:00+00:00" }
        ],
        "order_items": [
          { "id": "@order_items:kit", "order_id": "@orders:hlj", "item_type": "kit", "quantity": 1, "unit_price_minor": 2450, "currency_code": "JPY" },
          { "id": "@order_items:marker", "order_id": "@orders:hlj", "item_type": "consumable", "catalog_ref_id": "@consumables:marker", "quantity": 3, "unit_price_minor": 330, "currency_code": "JPY" }
        ],
        "kits": [
          { "id": "@kits:a", "name": "Zaku II", "grade": "HG", "scale": "1/144", "status": "backlog", "order_item_id": "@order_items:kit", "status_updated_at": "2026-03-20T00:00:00+00:00" }
        ]
      },
      "steps": [
        {
          "op": "import_archive",
          "args": { "mode": "merge", "archive": "export" },
          "result": { "created": 0, "updated": 0, "skipped": 0, "kits_spawned": 0 }
        }
      ],
      "then": "unchanged"
    },
    {
      "id": "adding-only-from-your-own-export-skips-every-row",
      "why": "add-only leaves every existing record alone: the six collection rows and the settings row are all skipped",
      "given": {
        "retailers": [{ "id": "@retailers:hlj", "name": "Hobby Link Japan", "rating": 5 }],
        "consumables": [
          { "id": "@consumables:marker", "name": "Gundam Marker GM01", "category": "marker", "quantity_on_hand": 3 }
        ],
        "orders": [
          { "id": "@orders:hlj", "retailer_id": "@retailers:hlj", "order_date": "2026-03-14", "currency_code": "JPY", "received_at": "2026-03-20T00:00:00+00:00" }
        ],
        "order_items": [
          { "id": "@order_items:kit", "order_id": "@orders:hlj", "item_type": "kit", "quantity": 1, "unit_price_minor": 2450, "currency_code": "JPY" },
          { "id": "@order_items:marker", "order_id": "@orders:hlj", "item_type": "consumable", "catalog_ref_id": "@consumables:marker", "quantity": 3, "unit_price_minor": 330, "currency_code": "JPY" }
        ],
        "kits": [
          { "id": "@kits:a", "name": "Zaku II", "grade": "HG", "scale": "1/144", "status": "backlog", "order_item_id": "@order_items:kit", "status_updated_at": "2026-03-20T00:00:00+00:00" }
        ]
      },
      "steps": [
        {
          "op": "import_archive",
          "args": { "mode": "add_only", "archive": "export" },
          "result": { "created": 0, "updated": 0, "skipped": 7, "kits_spawned": 0 }
        }
      ],
      "then": "unchanged"
    },
    {
      "id": "replacing-everything-with-your-own-export-restores-it-exactly",
      "why": "replace-all deletes the collection and recreates all six rows with their own ids; the result is the collection it replaced",
      "given": {
        "retailers": [{ "id": "@retailers:hlj", "name": "Hobby Link Japan", "rating": 5 }],
        "consumables": [
          { "id": "@consumables:marker", "name": "Gundam Marker GM01", "category": "marker", "quantity_on_hand": 3 }
        ],
        "orders": [
          { "id": "@orders:hlj", "retailer_id": "@retailers:hlj", "order_date": "2026-03-14", "currency_code": "JPY", "received_at": "2026-03-20T00:00:00+00:00" }
        ],
        "order_items": [
          { "id": "@order_items:kit", "order_id": "@orders:hlj", "item_type": "kit", "quantity": 1, "unit_price_minor": 2450, "currency_code": "JPY" },
          { "id": "@order_items:marker", "order_id": "@orders:hlj", "item_type": "consumable", "catalog_ref_id": "@consumables:marker", "quantity": 3, "unit_price_minor": 330, "currency_code": "JPY" }
        ],
        "kits": [
          { "id": "@kits:a", "name": "Zaku II", "grade": "HG", "scale": "1/144", "status": "backlog", "order_item_id": "@order_items:kit", "status_updated_at": "2026-03-20T00:00:00+00:00" }
        ]
      },
      "steps": [
        {
          "op": "import_archive",
          "args": { "mode": "replace_all", "archive": "export", "confirm": "REPLACE" },
          "result": { "created": 6, "updated": 0, "skipped": 0, "kits_spawned": 0 }
        }
      ],
      "then": "unchanged"
    },
    {
      "id": "importing-a-received-order-never-adds-stock",
      "why": "rule 10: quantity_on_hand comes only from the catalog sheets; a received line in an import states history, it doesn't deliver",
      "given": {
        "consumables": [
          { "id": "@consumables:cement", "name": "Tamiya Extra Thin Cement", "category": "cement", "quantity_on_hand": 1 }
        ]
      },
      "steps": [
        {
          "op": "import_archive",
          "args": {
            "mode": "merge",
            "archive": {
              "tables": {
                "orders": [
                  {
                    "id": "@orders:sheet",
                    "retailer_name": "Corner Hobbies",
                    "order_date": "2026-02-01",
                    "currency_code": "AUD",
                    "received_at": "2026-02-01T05:00:00+00:00"
                  }
                ],
                "order_items": [
                  {
                    "id": "@order_items:sheet",
                    "order_id": "@orders:sheet",
                    "item_type": "consumable",
                    "catalog_name": "Tamiya Extra Thin Cement",
                    "quantity": "2",
                    "unit_price": "7.00",
                    "currency_code": "AUD"
                  }
                ]
              }
            }
          },
          "result": { "created": 3, "updated": 0 }
        }
      ],
      "then": {
        "tables": {
          "retailers": [{ "name": "Corner Hobbies" }],
          "orders": [{ "id": "@orders:sheet", "received_at": "2026-02-01T05:00:00+00:00" }],
          "order_items": [
            { "id": "@order_items:sheet", "catalog_ref_id": "@consumables:cement", "quantity": 2, "unit_price_minor": 700 }
          ]
        }
      }
    },
    {
      "id": "editing-an-imported-received-line-up-adds-the-difference",
      "why": "rule 2 after rule 10: the import states the cement on hand and delivers nothing; the edit then applies the difference to that count, +1",
      "given": {},
      "steps": [
        {
          "op": "import_archive",
          "args": {
            "mode": "merge",
            "archive": {
              "tables": {
                "consumables": [
                  { "id": "@consumables:cement", "name": "Tamiya Extra Thin Cement", "category": "cement", "quantity_on_hand": "2" }
                ],
                "orders": [
                  { "id": "@orders:sheet", "retailer_name": "Corner Hobbies", "order_date": "2026-02-01", "currency_code": "AUD", "received_at": "2026-02-01T05:00:00+00:00" }
                ],
                "order_items": [
                  { "id": "@order_items:sheet", "order_id": "@orders:sheet", "item_type": "consumable", "catalog_name": "Tamiya Extra Thin Cement", "quantity": "2", "unit_price": "7.00", "currency_code": "AUD" }
                ]
              }
            }
          },
          "result": { "created": 4, "updated": 0 }
        },
        {
          "op": "update_order",
          "args": {
            "order_id": "@orders:sheet",
            "items": [
              { "id": "@order_items:sheet", "item_type": "consumable", "catalog_ref_id": "@consumables:cement", "quantity": 3, "unit_price_minor": 700, "currency_code": "AUD" }
            ]
          }
        }
      ],
      "then": {
        "tables": {
          "retailers": [{ "name": "Corner Hobbies" }],
          "orders": [{ "id": "@orders:sheet", "received_at": "2026-02-01T05:00:00+00:00" }],
          "order_items": [{ "id": "@order_items:sheet", "catalog_ref_id": "@consumables:cement", "quantity": 3 }],
          "consumables": [{ "id": "@consumables:cement", "quantity_on_hand": 3 }]
        }
      }
    },
    {
      "id": "editing-an-imported-received-line-down-takes-the-difference",
      "why": "rule 2 after rule 10: the edit takes the difference, 1, off the count the sheet stated, not the line's whole quantity",
      "given": {},
      "steps": [
        {
          "op": "import_archive",
          "args": {
            "mode": "merge",
            "archive": {
              "tables": {
                "consumables": [
                  { "id": "@consumables:cement", "name": "Tamiya Extra Thin Cement", "category": "cement", "quantity_on_hand": "2" }
                ],
                "orders": [
                  { "id": "@orders:sheet", "retailer_name": "Corner Hobbies", "order_date": "2026-02-01", "currency_code": "AUD", "received_at": "2026-02-01T05:00:00+00:00" }
                ],
                "order_items": [
                  { "id": "@order_items:sheet", "order_id": "@orders:sheet", "item_type": "consumable", "catalog_name": "Tamiya Extra Thin Cement", "quantity": "2", "unit_price": "7.00", "currency_code": "AUD" }
                ]
              }
            }
          },
          "result": { "created": 4, "updated": 0 }
        },
        {
          "op": "update_order",
          "args": {
            "order_id": "@orders:sheet",
            "items": [
              { "id": "@order_items:sheet", "item_type": "consumable", "catalog_ref_id": "@consumables:cement", "quantity": 1, "unit_price_minor": 700, "currency_code": "AUD" }
            ]
          }
        }
      ],
      "then": {
        "tables": {
          "retailers": [{ "name": "Corner Hobbies" }],
          "orders": [{ "id": "@orders:sheet", "received_at": "2026-02-01T05:00:00+00:00" }],
          "order_items": [{ "id": "@order_items:sheet", "catalog_ref_id": "@consumables:cement", "quantity": 1 }],
          "consumables": [{ "id": "@consumables:cement", "quantity_on_hand": 1 }]
        }
      }
    },
    {
      "id": "deleting-an-imported-received-order-takes-its-line-off-stock",
      "why": "rule 2 after rule 10: delete undoes the entry, so the received line's 2 come off the 2 the sheet stated; the retailer stays",
      "given": {},
      "steps": [
        {
          "op": "import_archive",
          "args": {
            "mode": "merge",
            "archive": {
              "tables": {
                "consumables": [
                  { "id": "@consumables:cement", "name": "Tamiya Extra Thin Cement", "category": "cement", "quantity_on_hand": "2" }
                ],
                "orders": [
                  { "id": "@orders:sheet", "retailer_name": "Corner Hobbies", "order_date": "2026-02-01", "currency_code": "AUD", "received_at": "2026-02-01T05:00:00+00:00" }
                ],
                "order_items": [
                  { "id": "@order_items:sheet", "order_id": "@orders:sheet", "item_type": "consumable", "catalog_name": "Tamiya Extra Thin Cement", "quantity": "2", "unit_price": "7.00", "currency_code": "AUD" }
                ]
              }
            }
          },
          "result": { "created": 4, "updated": 0 }
        },
        { "op": "delete_order", "args": { "order_id": "@orders:sheet" } }
      ],
      "then": {
        "tables": {
          "retailers": [{ "name": "Corner Hobbies" }],
          "orders": [],
          "order_items": [],
          "consumables": [{ "id": "@consumables:cement", "quantity_on_hand": 0 }]
        }
      }
    },
    {
      "id": "deleting-an-imported-order-below-its-line-is-refused",
      "why": "rule 2 after rule 10: the sheet says 1 on hand, so undoing a received line of 2 would take stock below zero; the import stays as it landed",
      "given": {},
      "steps": [
        {
          "op": "import_archive",
          "args": {
            "mode": "merge",
            "archive": {
              "tables": {
                "consumables": [
                  { "id": "@consumables:cement", "name": "Tamiya Extra Thin Cement", "category": "cement", "quantity_on_hand": "1" }
                ],
                "orders": [
                  { "id": "@orders:sheet", "retailer_name": "Corner Hobbies", "order_date": "2026-02-01", "currency_code": "AUD", "received_at": "2026-02-01T05:00:00+00:00" }
                ],
                "order_items": [
                  { "id": "@order_items:sheet", "order_id": "@orders:sheet", "item_type": "consumable", "catalog_name": "Tamiya Extra Thin Cement", "quantity": "2", "unit_price": "7.00", "currency_code": "AUD" }
                ]
              }
            }
          },
          "result": { "created": 4, "updated": 0 }
        },
        {
          "op": "delete_order",
          "args": { "order_id": "@orders:sheet" },
          "expect": { "refused": { "kind": "conflict", "code": "stock.insufficient", "params": { "name": "Tamiya Extra Thin Cement", "on_hand": 1, "requested": 2 } } }
        }
      ],
      "then": {
        "tables": {
          "retailers": [{ "name": "Corner Hobbies" }],
          "orders": [{ "id": "@orders:sheet", "received_at": "2026-02-01T05:00:00+00:00" }],
          "order_items": [{ "id": "@order_items:sheet", "catalog_ref_id": "@consumables:cement", "quantity": 2 }],
          "consumables": [{ "id": "@consumables:cement", "quantity_on_hand": 1 }]
        }
      }
    }
  ]
}
