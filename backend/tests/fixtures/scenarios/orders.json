          "op": "create_order",
          "args": {
            "retailer_id": "@retailers:hlj",
            "order_date": "2026-03-14",
            "currency_code": "AUD",
            "shipping_cost_minor": 500,
            "items": [
              { "item_type": "other", "quantity": 2, "unit_price_minor": 9000, "currency_code": "JPY", "description": "Nippers" },
              { "item_type": "other", "quantity": 1, "unit_price_minor": 400, "currency_code": "AUD", "description": "Carry bag" }
