# Copy to .env beside the downloaded docker-compose.yml. Set a unique password.
POSTGRES_USER=plamotrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plamotrack

# Default: accessible on this host only; put an HTTPS proxy in front for hosting.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# PUBLIC_BASE_URL=https://plamotrack.example
# TRUSTED_PROXIES=127.0.0.1
# ALLOWED_HOSTS=nas.lan

# Local owner setup is the default; read the one-time link in `docker compose logs api`.
# Optional OIDC requires all five settings below and an HTTPS public URL above.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://idp.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# MCP_OAUTH_SIGNING_KEY=  # generate with: openssl rand -hex 32

# First-run currency; subsequently changed through Settings.
REFERENCE_CURRENCY=AUD
# Full configuration reference: https://docs.gunp.la
