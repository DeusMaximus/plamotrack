#!/bin/sh
# Sourced by the nginx image's entrypoint before its envsubst step (the
# `.envsh` suffix is what makes it sourced rather than executed, so the export
# survives). Assembles PLAMOTRACK_SERVER_NAMES — the `server_name` line of the
# allow server in default.conf.template — from the same three inputs the API's
# Host allowlist is built from (backend/app/ingress.py, backend/app/hostnames.py):
# the loopback names, the host of PUBLIC_BASE_URL, every WEB_BIND that names
# something, and ALLOWED_HOSTS. The two derivations are held equal by
# backend/tests/test_ingress.py, which runs this file under `sh` over one corpus.
#
# Normalisation, matching the API's: lowercase; ports dropped (nginx matches
# server_name on the host alone); an IPv6 literal bracketed; terminal DNS dots
# dropped (nginx drops them from the request Host before matching, so a dotted
# server_name would never match — PR #196 review, P3-3); duplicates skipped
# (nginx warns on a repeated server_name); the one wildcard form is `*.domain`,
# any other `*` placement is ignored here and refused by the API at startup.

set -e

plamotrack_add_name() {
    name=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
    case "$name" in
        "") return ;;
        \[*) name="${name%%]*}]" ;;                       # [v6]:port -> [v6]
        *:*:*) name="[$name]" ;;                          # bare v6 -> [v6]
        *) name="${name%%:*}" ;;                          # host:port -> host
    esac
    name="${name%.}"                                      # one terminal DNS dot, as the API
    case "$name" in
        ""|"[]") return ;;
        \*.?*) ;;
        *\**) return ;;
    esac
    case " ${PLAMOTRACK_SERVER_NAMES} " in
        *" ${name} "*) return ;;
    esac
    PLAMOTRACK_SERVER_NAMES="${PLAMOTRACK_SERVER_NAMES} ${name}"
}

PLAMOTRACK_SERVER_NAMES="localhost 127.0.0.1 [::1]"

if [ -n "${PUBLIC_BASE_URL:-}" ]; then
    host="${PUBLIC_BASE_URL#*://}"                        # strip the scheme
    host="${host%%/*}"                                    # strip any path
    host="${host##*@}"                                    # strip any userinfo
    plamotrack_add_name "$host"
fi

case "${WEB_BIND:-}" in
    ""|0.0.0.0|::|"[::]") ;;                              # binds everything, names nothing
    *) plamotrack_add_name "${WEB_BIND}" ;;               # loopback aliases included (P3-2)
esac

if [ -n "${ALLOWED_HOSTS:-}" ]; then
    for entry in $(printf '%s' "${ALLOWED_HOSTS}" | tr ',' ' '); do
        plamotrack_add_name "$entry"
    done
fi

export PLAMOTRACK_SERVER_NAMES
echo "plamotrack: server_name ${PLAMOTRACK_SERVER_NAMES}"
