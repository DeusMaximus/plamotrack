# --- Postgres (consumed by the docker-compose db service) ---
POSTGRES_USER=plamotrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plamotrack

# --- API ---
# Async DSN used by the API and Alembic migrations.
# With the bundled compose stack this points at the db service; for local dev
# against a host Postgres, adjust host/port accordingly.
DATABASE_URL=postgresql+asyncpg://plamotrack:change-me@localhost:5432/plamotrack
