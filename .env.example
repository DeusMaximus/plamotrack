# Copy to .env in this directory and change the password. One file: docker
# compose reads it for the db service, and the API reads it for its connection.

POSTGRES_USER=plamotrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plamotrack

# Where a source-run API reaches Postgres. docker-compose.dev.yml publishes the
# database on POSTGRES_PORT; the packaged API is pinned to db:5432 internally.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Where the bundled stack answers: http://127.0.0.1:8080 by default. This is the
# only port published, and it fronts the UI, the API (/api) and MCP (/mcp).
#
# 127.0.0.1 means only this machine can connect. 0.0.0.0 means every device on
# the network can reach the login. The browser needs the owner login (M6-3) and
# scripts and MCP clients need a personal access token minted under Settings
# (M6-4), but there is no tested TLS path yet, so keep this on a network you trust.
#
# Running it on a server and want it from your laptop? Prefer an SSH tunnel or a
# private/VPN address over 0.0.0.0. docs/operations.md ("Reaching it from another
# machine") covers all three, including why a Linux host firewall does NOT block
# a published Docker port.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# --- Which names the instance answers to ---------------------------------------
# The instance refuses a request whose Host header is not a name it knows, with
# 421 Misdirected Request — the one setting in this file that can lock you out of
# your own install if it is wrong. localhost, 127.0.0.1, [::1] and a WEB_BIND
# address are always known. Anything else you type into a browser or an MCP
# client — a LAN hostname, a container name, a name a reverse proxy forwards —
# goes here, comma-separated, without ports. Wildcards like *.home.arpa work; a
# bare * (or any other wildcard placement) is refused at startup, on purpose.
# Nothing is written or lost while it is wrong: fix the line, then
# `docker compose up -d`.
# ALLOWED_HOSTS=nas.lan,plamotrack.home.arpa

# The address a browser reaches this instance at, when it is not
# http://localhost on WEB_PORT: scheme, host and port, nothing after. Its host is
# allowed automatically, and behind an HTTPS reverse proxy it is what lets the
# browser's https:// origin be recognised as the instance's own. In oidc mode it
# is also the identity MCP clients are bound to (the OAuth issuer is
# <PUBLIC_BASE_URL>/mcp), so pick the name you mean to keep: changing it later
# means every linked MCP client re-authorises.
# PUBLIC_BASE_URL=http://nas.lan:8080

# How the owner signs in (design notes §5.4). `local` (the default): the setup
# token from the API log plus a password you choose. `oidc`: a sign-in at an
# OpenID Connect provider (Google, Keycloak, Authentik, …) — the account that
# completes the first sign-in with the setup token becomes the owner, bound by
# the provider's stable (issuer, subject), and no password exists. The two are
# mutually exclusive; switching is this line plus `docker compose up -d`. There
# is no "off". In oidc mode the three OIDC_* lines, PUBLIC_BASE_URL and
# MCP_OAUTH_SIGNING_KEY are all required, and PUBLIC_BASE_URL must be https://
# (or localhost / 127.0.0.1 for development) — see below. The provider's client
# must allow two redirect URIs: <PUBLIC_BASE_URL>/api/auth/oidc/callback for the
# browser and <PUBLIC_BASE_URL>/mcp/auth/callback for MCP clients.
# AUTH_MODE=local
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- MCP clients that sign in through the provider (oidc mode) -----------------
# In oidc mode the instance is also an OAuth authorization server for MCP
# clients that speak OAuth — Claude web, ChatGPT web, MCP Inspector: they
# discover it at <PUBLIC_BASE_URL>/.well-known/oauth-authorization-server/mcp,
# send you to the same provider, and get their own access tokens; only the
# bound owner's account is accepted, and every token acts as the owner with
# read and write access to the collection (never instance settings). Personal
# access tokens keep working on /mcp/ too. Local mode has none of this.
#
# MCP_OAUTH_SIGNING_KEY signs those tokens and encrypts the proxy's state in the
# database: 32 random bytes as 64 hex characters — `openssl rand -hex 32`.
# Installation identity like PUBLIC_BASE_URL: change it and every MCP client
# re-authorises (nothing else is lost). Because the OAuth server is
# <PUBLIC_BASE_URL>/mcp, oidc mode needs an https:// PUBLIC_BASE_URL — TLS in
# front of the stack — or localhost / 127.0.0.1 while developing; a plain-http
# LAN address stays on local mode.
# MCP_OAUTH_SIGNING_KEY=
#
# Optional: which callback URIs a *dynamically registering* MCP client may
# register, as comma-separated patterns (`http://localhost:*`,
# `https://*.example.com/*`). It narrows registration and never replaces it — a
# client is still sent only to a URI it registered. When set it applies to
# every client kind, so it must also admit the web clients you use:
# https://claude.ai/api/mcp/auth_callback and https://chatgpt.com/connector/oauth/*.
# Leave it unset unless you have a reason.
# MCP_OAUTH_ALLOWED_REDIRECT_URIS=

# Browser origins allowed to write, beyond the instance's own and loopback ones.
# Rarely needed — an alias reached over a scheme the app itself does not see.
# ALLOWED_ORIGINS=https://plamotrack.example

# IPs or CIDRs of a reverse proxy in front of the stack whose X-Forwarded-For
# should be believed for the client's address. Nothing reads that address in
# this release (rate limiting and audit come later in M6); leave it unset.
# TRUSTED_PROXIES=

# Optional. Left unset, the API assembles the DSN from the values above, so the
# password is only written once. Set it to point at a Postgres you manage
# yourself — the POSTGRES_* values then only configure the compose db service.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/plamotrack

# Your own currency: what order forms default to, and the currency foreign
# purchases are converted into for comparison. Any ISO 4217 code.
#
# First-run bootstrap only: the migration that creates the instance settings
# seeds this value into the database, and from then on the database row is the
# setting — change it via PATCH /settings (Settings page from M5.1), not here.
# Editing this after first run does nothing to an existing installation.
#
# Each converted amount stores the currency it was captured in, so changing the
# setting later affects new entries only — it never restates what past orders cost.
REFERENCE_CURRENCY=AUD
