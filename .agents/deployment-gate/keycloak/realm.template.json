{
  "realm": "plamotrack",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "users": [
    {
      "username": "owner",
      "enabled": true,
      "email": "owner@example.test",
      "emailVerified": true,
      "firstName": "Owner",
      "lastName": "Person",
      "credentials": [{"type": "password", "value": "owner-password", "temporary": false}]
    },
    {
      "username": "stranger",
      "enabled": true,
      "email": "stranger@example.test",
      "emailVerified": true,
      "firstName": "Not",
      "lastName": "Owner",
      "credentials": [{"type": "password", "value": "stranger-password", "temporary": false}]
    }
  ],
  "clients": [
    {
      "clientId": "plamotrack",
      "name": "plamotrack (deployment gate)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "plamotrack-gate-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://PLAMOTRACK_TEST_NAME/api/auth/oidc/callback",
        "https://PLAMOTRACK_TEST_NAME/mcp/auth/callback",
        "https://PLAMOTRACK_TUNNEL_NAME/api/auth/oidc/callback",
        "https://PLAMOTRACK_TUNNEL_NAME/mcp/auth/callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["basic", "openid", "email", "profile"],
      "optionalClientScopes": ["offline_access"]
    }
  ]
}
